NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://wholesale:change-me@localhost:5432/wholesale
DATABASE_SSL=false
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=

# Used only by the one-time owner provisioning command.
OWNER_EMAIL=owner@example.com
OWNER_NAME=Store Owner
OWNER_PASSWORD=replace-with-a-long-random-password
